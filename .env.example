# Copy to .env only if you want to enable the AI assistant.
# The app runs with no .env at all: AI_PROVIDER defaults to none.

# Path to the input workbook, relative to the repository root.
DATA_PATH=data/Atlas_Fresh_Production_Commercial_Data.xlsx

# none | anthropic | ollama
AI_PROVIDER=none

# Used only when AI_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Used only when AI_PROVIDER=ollama (free, runs on your machine).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Seconds to wait for the AI provider before giving up.
AI_TIMEOUT_SECONDS=20
